<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/w_bg"
    android:padding="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:baselineAligned="true">
        <TextView android:id="@+id/title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="13.5sp" android:textStyle="bold" android:textColor="@color/w_ink"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/count"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10.5sp" android:textStyle="bold" android:textColor="@color/w_mark" />
    </LinearLayout>

    <LinearLayout android:id="@+id/r0"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <View android:id="@+id/b0"
            android:layout_width="3dp" android:layout_height="match_parent"
            android:layout_marginEnd="7dp" android:background="@drawable/w_bar_gov" />
        <TextView android:id="@+id/t0"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/w_ink"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r1"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <View android:id="@+id/b1"
            android:layout_width="3dp" android:layout_height="match_parent"
            android:layout_marginEnd="7dp" android:background="@drawable/w_bar_gov" />
        <TextView android:id="@+id/t1"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/w_ink"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r2"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <View android:id="@+id/b2"
            android:layout_width="3dp" android:layout_height="match_parent"
            android:layout_marginEnd="7dp" android:background="@drawable/w_bar_gov" />
        <TextView android:id="@+id/t2"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/w_ink"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/empty"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textSize="11.5sp"
        android:textColor="@color/w_ink2" android:visibility="gone" />

    <TextView android:id="@+id/foot"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:paddingTop="6dp"
        android:textSize="10.5sp" android:textColor="@color/w_ink2"
        android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
