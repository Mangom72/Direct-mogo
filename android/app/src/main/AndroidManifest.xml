<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 스토어를 거치지 않으므로 새 버전을 앱이 직접 받아 설치 화면으로 넘긴다.
         안드로이드 8+에서는 사용자가 이 앱에 한 번 '이 출처 허용'을 줘야 동작한다. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 문제지를 다른 앱 위에 반투명하게 띄우는 기능. 사용자가 설정에서 직접 켜야
         하는 권한이라, 켜지 않으면 그 단추만 동작하지 않고 나머지는 그대로다. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 띄운 창은 우리 화면을 떠난 뒤에도 살아 있어야 한다. 그래서 서비스가 들고
         있고, 그 서비스는 포그라운드여야 죽지 않는다(알림이 함께 뜬다). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 사이트 주소를 앱이 받는다. autoVerify가 실제로 걸리려면 도메인 뿌리에
                 .well-known/assetlinks.json이 있어야 하는데, 여기는 프로젝트 페이지라
                 그 자리가 사용자 페이지 저장소에 있다(docs/android.md 참고). 확인이
                 안 된 상태에서도 설정 > 기본으로 열기에서 켜면 동작한다. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="mangom72.github.io"
                      android:pathPrefix="/Direct-mogo/" />
            </intent-filter>
        </activity>

        <!-- 문제·정답·해설을 앱 안에서 읽는 화면. WebView에 PDF 뷰어가 없어 직접 그린다. -->
        <activity
            android:name=".PdfViewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:parentActivityName=".MainActivity" />

        <!-- 문제지를 다른 앱 위에 띄워 두는 창. 알림 하나를 달고 살아 있는다.
             targetSdk 34 부터 포그라운드 서비스는 유형을 반드시 밝혀야 하는데,
             떠 있는 창에 맞는 기성 유형이 없어 specialUse 를 쓴다. -->
        <service
            android:name=".FloatService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_paper_overlay" />
        </service>

        <!-- 받아둔 파일을 외부 뷰어에 넘기려면 content:// 로 줘야 한다 (file:// 는 API 24+에서 막힘) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="kr.gijul.direct.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
